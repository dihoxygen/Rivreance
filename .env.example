# Rivreance configuration. Copy to .env and fill in what you need.
# Everything here is read by the Python backend only — never expose these to the browser.

# --- USGS -------------------------------------------------------------------
# Optional. The OGC API works unauthenticated; a key raises your rate limits.
# Request one at https://api.waterdata.usgs.gov/
USGS_API_KEY=

# --- Storage ----------------------------------------------------------------
# file     = JSON snapshots under backend/.data (default, no cloud setup needed)
# supabase = upsert through PostgREST using the service-role key
RIVREANCE_STORE_BACKEND=file
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Pipeline tuning (defaults shown; all optional) -------------------------
# RIVREANCE_STALE_AFTER_MINUTES=120          # readings older than this render gray
# RIVREANCE_INACTIVE_AFTER_DAYS=30           # skip gages with no reading this recent
# RIVREANCE_MIN_STREAM_ORDER=3               # smallest NHD stream order to ingest
# RIVREANCE_GAGE_SNAP_DISTANCE_M=750         # gage -> flowline snap radius
# RIVREANCE_MAINSTEM_ASSIGN_DISTANCE_KM=60   # how far a status travels along a mainstem
# RIVREANCE_PROXIMITY_ASSIGN_DISTANCE_KM=5   # fallback radius for off-mainstem reaches
# RIVREANCE_HISTORY_DAYS=30                  # window for percentile thresholds
# RIVREANCE_SERIES_HOURS=24                  # window cached for popup charts

# --- API --------------------------------------------------------------------
# RIVREANCE_CACHE_TTL_SECONDS=900            # response cache; keep >= 900 for USGS
# RIVREANCE_CORS_ALLOW_ORIGINS=http://localhost:3000
# RIVREANCE_LOG_LEVEL=INFO

# --- Frontend (frontend/.env.local) -----------------------------------------
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_MAPTILER_KEY=                  # optional; falls back to USGS topo tiles
