# Copy to `.env.local`. Only EXPO_PUBLIC_* variables reach the app bundle, so never put
# secrets here — the USGS and Supabase keys stay server-side in the Python backend.

# Rivreance API. Leave unset in development: the app defaults to port 8000 on whichever
# host served the Expo bundle, which is what a phone on the same Wi-Fi can reach.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000/api/v1

# Optional. Without a key the map uses keyless USGS topo raster tiles.
# EXPO_PUBLIC_MAPTILER_KEY=
